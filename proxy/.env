# ==========================================
# CONFIGURACIÓN DEL PROXY (.env)
# ==========================================

# Puerto donde correrá este Proxy
SERVER_PORT=8081

# --- CONEXIÓN: FACULTAD / VPN (PRODUCCIÓN) ---
# [cite_start]Apuntamos a los servidores reales de la cátedra [cite: 12, 14, 15]
REDIS_HOST=192.168.194.250
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=192.168.194.250:9092

# --- IDENTIFICACIÓN ---
# ¡TU ID ÚNICO! [cite_start]No uses el de tu amigo o tendrás conflictos [cite: 51]
KAFKA_GROUP_ID=elcomandante18

# --- CONEXIÓN CON TU BACKEND ---
# A dónde avisar cuando llega un mensaje de Kafka
# (Tu Backend sigue corriendo en tu PC en el 8080)
BACKEND_URL=http://localhost:8080
# ==========================================
# CONFIGURACIÓN DEL PROXY (.env)
# ==========================================

# Puerto donde correrá este Proxy
SERVER_PORT=8081

# --- CONEXIÓN: ELEGIR CASA O FACULTAD ---

# OPCIÓN 1: CASA (Usando Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OPCIÓN 2: FACULTAD (Si estás conectado al Wi-Fi de allá)
# Descomenta estas 3 y comenta las de arriba
# REDIS_HOST=192.168.194.250
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=192.168.194.250:9092

# --- IDENTIFICACIÓN ---
# TU ID DE GRUPO (¡Fundamental!)
KAFKA_GROUP_ID=elcomandante18

# --- CONEXIÓN CON TU BACKEND ---
# A dónde avisar cuando llega un mensaje de Kafka
BACKEND_URL=http://localhost:8080
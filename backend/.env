# --- BASE DE DATOS LOCAL (MySQL) ---
# Asegúrate de crear esta base de datos en tu MySQL Workbench/DBeaver
DB_NAME=eventos_BD
DB_USERNAME=root

# Pon la contraseña real de tu MySQL local (si no tienes, déjalo vacío)
DB_PASSWORD=root

# --- SEGURIDAD (JWT) ---
# Esta clave debe coincidir con la que uses para generar tokens
JWT_SECRET=MiClaveSecretaSuperLargaParaJWTQueDebeSerDeAlMenos64CaracteresParaQueSeaSegura2025
# Tiempo en segundos (86400 = 1 día)
JWT_EXPIRATION=86400

# ... (Base de datos y JWT igual que antes) ...

# Cátedra
CATEDRA_TOKEN=tu_token_aqui
CATEDRA_URL=http://192.168.194.250:8080

# Proxy
PROXY_URL=http://localhost:8081
